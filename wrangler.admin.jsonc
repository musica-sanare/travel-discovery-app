{
  // Admin Worker: admin SPA + admin API. Every URL of this Worker must be
  // protected by Worker-level Cloudflare Access, and every admin API request
  // also validates the Access JWT in code (docs/working/DECISIONS.md, ADR-004).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travel-discovery-admin",
  "main": "./admin-worker/index.ts",
  "compatibility_date": "2026-10-12",
  "upload_source_maps": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      // Same database as the public Worker (ADR-018). This config owns the
      // migrations. "local-travel-discovery" is a local-only placeholder: both
      // configs must use the same database_id so local development shares one
      // database (without an id, local state is keyed per binding). Replace it
      // with the real id only after the owner approves creating the database.
      "binding": "ADMIN_DB",
      "database_name": "travel-discovery",
      "database_id": "local-travel-discovery",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    // Local end-to-end tests only (playwright.config.ts): selected with
    // CLOUDFLARE_ENV=e2e for the admin dev server, so the allowed path does not
    // depend on a developer's .dev.vars. The identity is honoured only by dev
    // builds; production builds do not contain that code (ADR-004,
    // scripts/verify-bundles.mjs). Never deploy this environment.
    "e2e": {
      "vars": { "ADMIN_DEV_IDENTITY_EMAIL": "e2e-admin@example.test" },
      "d1_databases": [
        {
          "binding": "ADMIN_DB",
          "database_name": "travel-discovery",
          "database_id": "local-travel-discovery",
          "migrations_dir": "migrations"
        }
      ]
    },
    // Deployment environment (docs/en/DEPLOYMENT.md "3.3 Configuration" and
    // "3.4 Cloudflare Access"). Enable workers_dev only while Worker-level
    // Access ("All traffic") protects this Worker. Without the two ACCESS_*
    // values the admin API answers 403 (fail closed). Owner decision
    // (2026-10-18): production keeps the top-level Worker name. The preview
    // environment was removed on 2026-10-31 (ADR-033).
    "production": {
      "name": "travel-discovery-admin",
      "workers_dev": true,
      "preview_urls": false,
      "upload_source_maps": true,
      // Invocation logs would store each request with its IP address, headers,
      // and geolocation; only the app's own console lines are kept
      // (docs/working/DECISIONS.md "Phase 7 verification log").
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "d1_databases": [
        {
          // Same database as the public production Worker (ADR-018).
          "binding": "ADMIN_DB",
          "database_name": "travel-discovery-production",
          "database_id": "09ee8032-0e63-47b1-8b47-507d643d6255",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        // Keyed by the Access email (ADR-020); namespace_id unique in the account.
        { "name": "ADMIN_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } }
      ],
      "vars": {
        // Not secrets: the Access team domain and this Worker's Access
        // application audience (AUD) tag (ADR-004).
        "ACCESS_TEAM_DOMAIN": "https://spring-dew-55d0.cloudflareaccess.com",
        "ACCESS_POLICY_AUD": "7a068c1afbcbf628060ec8cbc0def82f5218fef5225fcd037dcff88c4bcf5995"
      }
    }
  }
}
