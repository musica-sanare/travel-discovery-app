{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travel-discovery",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "upload_source_maps": true,
  // Version URLs are public when enabled; keep them off unless explicitly
  // needed and protected (see docs/DECISIONS.md, ADR-004).
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      // Shared with the admin Worker (ADR-018). The public Worker only reads;
      // this is enforced by code structure and tests, not by a database
      // permission. Migrations are owned by wrangler.admin.jsonc, which also
      // explains the local-only placeholder database_id.
      "binding": "PUBLIC_DB",
      "database_name": "travel-discovery",
      "database_id": "local-travel-discovery"
    }
  ],
  // Deployment environments (docs/DEPLOYMENT.md "3.3 Configuration"), selected
  // with CLOUDFLARE_ENV at build time only. Bindings and vars are not inherited,
  // so each environment declares all of them. The top level above must never
  // get the ai or ratelimits bindings: an ai binding always connects to
  // Cloudflare, also from `npm run dev` and the tests (ADR-026 C). Never run
  // `npm run dev` with CLOUDFLARE_ENV set to a deployment environment.
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": false,
      "upload_source_maps": true,
      "observability": { "enabled": true },
      "d1_databases": [
        {
          // Created 2026-10-18 (docs/DEPLOYMENT.md "3.2 D1 databases").
          "binding": "PUBLIC_DB",
          "database_name": "travel-discovery-preview",
          "database_id": "d0f881f6-cc73-40cc-9de0-1460a5589625"
        }
      ],
      "ai": { "binding": "AI" },
      "ratelimits": [
        // namespace_id must be unique in the account (ADR-026 B).
        { "name": "AI_CLIENT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": {
        // Kill switch: anything but "true" means no model call (ADR-026 A).
        "AI_ASSIST_ENABLED": "false",
        "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
      }
    }
  }
}
