{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travel-discovery",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "upload_source_maps": true,
  // Version URLs are public when enabled; keep them off unless explicitly
  // needed and protected (see docs/working/DECISIONS.md, ADR-004).
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      // Shared with the admin Worker (ADR-018). The public Worker only reads;
      // this is enforced by code structure and tests, not by a database
      // permission. Migrations are owned by wrangler.admin.jsonc, which also
      // explains the local-only placeholder database_id.
      "binding": "PUBLIC_DB",
      "database_name": "travel-discovery",
      "database_id": "local-travel-discovery"
    }
  ],
  // Strict per-client AI quota (docs/working/DECISIONS.md ADR-029). A Durable
  // Object runs locally under `npm run dev` and the tests, with no connection
  // to Cloudflare, so the top level keeps it. Bindings and migrations are not
  // inherited, so every environment repeats them. SQLite-backed classes are
  // the only kind available on Workers Free; removing the class later needs a
  // `deleted_classes` migration.
  "durable_objects": { "bindings": [{ "name": "AI_CLIENT_LIMITER", "class_name": "AiClientLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiClientLimiter"] }],
  // Deployment environment (docs/en/DEPLOYMENT.md "3.3 Configuration"), selected
  // with CLOUDFLARE_ENV at build time only. Bindings and vars are not inherited,
  // so the environment declares all of them. The top level above must never
  // get the ai or ratelimits bindings: an ai binding always connects to
  // Cloudflare, also from `npm run dev` and the tests (ADR-026 C). Never run
  // `npm run dev` with CLOUDFLARE_ENV set to a deployment environment. The
  // preview environment was removed on 2026-10-31 (ADR-033).
  "env": {
    "production": {
      // Owner decision (2026-10-18): production keeps the top-level Worker name
      // instead of the default "travel-discovery-production".
      "name": "travel-discovery",
      "workers_dev": true,
      "preview_urls": false,
      "upload_source_maps": true,
      // Invocation logs would store each request with its IP address, headers,
      // and geolocation; only the app's own console lines are kept
      // (docs/working/DECISIONS.md "Phase 7 verification log").
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "d1_databases": [
        {
          // Created 2026-10-18 (docs/en/DEPLOYMENT.md "3.2 D1 databases").
          "binding": "PUBLIC_DB",
          "database_name": "travel-discovery-production",
          "database_id": "09ee8032-0e63-47b1-8b47-507d643d6255"
        }
      ],
      "ai": { "binding": "AI" },
      "ratelimits": [
        // namespace_id must be unique in the account (ADR-026 B).
        { "name": "AI_CLIENT_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }
      ],
      "durable_objects": { "bindings": [{ "name": "AI_CLIENT_LIMITER", "class_name": "AiClientLimiter" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiClientLimiter"] }],
      "vars": {
        // Kill switch: anything but "true" means no model call (ADR-026 A).
        "AI_ASSIST_ENABLED": "false",
        "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
      }
    }
  }
}
